generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String        @id @default(cuid())
  email          String        @unique
  passwordHash   String
  displayName    String
  avatarColor    String        @default("#6366f1")
  totalPoints    Int           @default(0)
  gamesPlayed    Int           @default(0)
  wins           Int           @default(0)
  correctAnswers Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  matches        MatchRecord[]
}

model CustomQuestion {
  id           String   @id @default(cuid())
  category     String
  difficulty   String
  prompt       String
  options      Json
  correctIndex Int
  explanation  String
  source       String   @default("external")
  createdAt    DateTime @default(now())
}

model MatchRecord {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  playerName String
  mode       String
  difficulty String
  score      Int
  crowns     Int
  won        Boolean  @default(false)
  createdAt  DateTime @default(now())
}
