# Conecte seu banco Neon Postgres (Vercel Storage) aqui ou nas Environment Variables da Vercel
# Sem DATABASE_URL, o app usa automaticamente um arquivo local (data/local-db.json) para testes no PC.
DATABASE_URL="postgresql://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Segredo para assinar os cookies JWT (gere valor aleatório único com pelo menos 32 caracteres em produção)
AUTH_SECRET=
